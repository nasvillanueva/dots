[include]
  path = ~/.gitconfig_personal
[includeIf "gitdir:~/dev/projects/"]
  path = ~/.gitconfig_work
[core]
  excludesfile = ~/.gitignore_global
[push]
  autoSetupRemote = true
# colors for neofusion
[color "diff"]
  new = green
[color "status"]
  added = yellow
  changed = red
[fetch]
  prune = true
[mergeTool]
  hideResolved = true
[merge]
  conflictStyle = "diff3"
[merge "mergiraf"]
    name = mergiraf
    driver = mergiraf merge --git %O %A %B -s %S -x %X -y %Y -p %P -l %L

